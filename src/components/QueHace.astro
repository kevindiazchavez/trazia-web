---
import Telefono from "./Telefono.astro";

const extras = [
    { icono: "i-mapa", titulo: "874 rutas", texto: "Del área metropolitana y del interior del país, con sus paradas y su recorrido." },
    { icono: "i-reloj", titulo: "Costo total y tiempo", texto: "Antes de salir sabes cuánto vas a pagar en total y cuánto te va a tomar el viaje." },
];
// El viaje encadenado de la segunda tarjeta (el de las capturas de la app).
const cadena = [
    { tipo: "bus", ruta: "44", color: "var(--neon)", texto: "Sube en Metrocentro" },
    { tipo: "pie", texto: "Camina 460 m hasta el otro bus" },
    { tipo: "bus", ruta: "102A", color: "#22d3ee", texto: "Bájate en el Puerto de La Libertad" },
];
---
<section class="seccion" id="que-hace">
    <div class="contenido">
        <div class="intro">
            <p data-revela>Trazia te dice cómo llegar a cualquier destino de El Salvador usando el transporte público.</p>
            <div class="titulo" data-revela>
                <span class="flecha" aria-hidden="true"><svg class="ic"><use href="#i-flecha-abajo" /></svg></span>
                <h2>Todo tu viaje, <em>antes de salir.</em></h2>
            </div>
        </div>

        <ul class="tarjetas" data-revela-grupo="0.15">
            <li class="elevable">
                <article class="tarjeta">
                    <span class="tarjeta-icono"><svg class="ic" aria-hidden="true"><use href="#i-direcciones" /></svg></span>
                    <h3>Tu viaje completo</h3>
                    <p>Qué buses tomar, en qué parada subirte, dónde bajarte, cuánto vas a tardar y cuánto vas a pagar en total.</p>
                    <div class="visual visual-telefono"><Telefono escala={0.72} pantallas={["itinerario"]} /></div>
                </article>
            </li>
            <li class="elevable">
                <article class="tarjeta tono-acento">
                    <span class="tarjeta-icono"><svg class="ic" aria-hidden="true"><use href="#i-transbordo" /></svg></span>
                    <h3>Hasta tres buses por viaje</h3>
                    <p>Si no hay un bus directo, Trazia une hasta tres rutas y te marca dónde cambiar, o cuándo te conviene caminar un tramo.</p>
                    <ol class="visual cadena" aria-hidden="true">
                        {cadena.map((c) => (
                            <li class={`c-${c.tipo}`}>
                                {c.tipo === "bus"
                                    ? <b class="chip" style={`--c: ${c.color}`}><svg class="ic"><use href="#i-bus" /></svg>{c.ruta}</b>
                                    : <b class="chip pie"><svg class="ic"><use href="#i-caminar" /></svg></b>}
                                <span>{c.texto}</span>
                            </li>
                        ))}
                    </ol>
                </article>
            </li>
            <li class="elevable">
                <article class="tarjeta tono-mapa">
                    <span class="tarjeta-icono"><svg class="ic" aria-hidden="true"><use href="#i-lugar" /></svg></span>
                    <h3>Síguelo en el mapa</h3>
                    <p>El recorrido se dibuja con las paradas marcadas, para que sepas cuándo te toca bajar.</p>
                    <div class="visual mapita" aria-hidden="true">
                        <svg viewBox="0 0 300 200" preserveAspectRatio="xMidYMid slice">
                            <rect width="300" height="200" class="mm-fondo" />
                            <path class="mm-calle" d="M-10 60 H310 M-10 140 H310 M70 -10 V210 M190 -10 V210 M-10 190 L310 20" />
                            <path class="mm-ruta" d="M30 175 C60 170 70 140 100 130 S150 120 170 95 S230 60 265 40" />
                            <circle class="mm-parada" cx="30" cy="175" r="6" />
                            <circle class="mm-parada" cx="100" cy="130" r="6" />
                            <circle class="mm-parada" cx="170" cy="95" r="6" />
                            <circle class="mm-parada destino" cx="265" cy="40" r="8" />
                            <g transform="translate(135 115)"><circle class="mm-bus" r="13" /><use href="#i-bus" x="-8" y="-8" width="16" height="16" fill="#07100d" /></g>
                        </svg>
                        <span class="bajate">Tu parada</span>
                    </div>
                </article>
            </li>
        </ul>

        <ul class="extras" data-revela-grupo="0.15">
            {extras.map((e) => (
                <li class="elevable">
                    <span class="extra-icono"><svg class="ic" aria-hidden="true"><use href={`#${e.icono}`} /></svg></span>
                    <div><h3>{e.titulo}</h3><p>{e.texto}</p></div>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    .seccion { padding: 110px 0 60px; }
    .intro { display: grid; grid-template-columns: 1fr 1.25fr; gap: 32px 64px; align-items: center; margin-bottom: 56px; }
    .intro > p { margin: 0; max-width: 26em; color: var(--suave); font-size: 1.05rem; }
    .titulo { display: flex; align-items: center; gap: 24px; }
    .flecha { width: 48px; height: 48px; flex: none; border-radius: 50%; display: grid; place-items: center; background: var(--oscuro); color: #fff; }

    .tarjetas { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
    .tarjetas > li { border-radius: 30px; }
    .tarjeta {
        position: relative; height: 470px; overflow: hidden; border-radius: inherit; padding: 28px 28px 0;
        background: linear-gradient(180deg, var(--tarjeta-2), var(--tarjeta)); border: 1px solid var(--borde);
        display: flex; flex-direction: column; align-items: flex-end; text-align: right;
    }
    .tono-acento { background: var(--acento-claro); border-color: rgba(0, 230, 118, .25); }
    .tono-mapa { background: #e8f0ff; border-color: rgba(59, 130, 246, .2); }
    .tarjeta-icono { flex: none; width: 46px; height: 46px; border-radius: 50%; display: grid; place-items: center; background: var(--oscuro); color: #fff; }
    .tarjeta-icono .ic { width: 22px; height: 22px; }
    .tarjeta h3 { margin: 18px 0 8px; font-size: 1.45rem; line-height: 1.15; max-width: 11em; }
    .tarjeta p { margin: 0; color: var(--suave); font-size: .92rem; max-width: 22em; }
    .visual { margin-top: auto; align-self: stretch; }

    .visual-telefono { position: relative; height: 230px; }
    .visual-telefono :global(.tel) { position: absolute; left: 18px; top: 58px; transform: rotate(-14deg); transform-origin: 0 0; }

    /* La cadena de buses: cada tramo en una tarjeta, unidos por una línea. */
    .cadena { list-style: none; margin-bottom: 0; padding: 0 0 30px; display: grid; gap: 10px; text-align: left; position: relative; }
    .cadena::before { content: ""; position: absolute; left: 30px; top: 20px; bottom: 50px; border-left: 2px dashed rgba(10, 125, 62, .35); }
    .cadena li {
        position: relative; display: flex; align-items: center; gap: 12px; padding: 10px 14px 10px 10px; border-radius: 16px;
        background: #fff; border: 1px solid var(--borde); box-shadow: 0 10px 24px -16px rgba(17, 24, 39, .3); font-size: .86rem; font-weight: 600;
    }
    .cadena .c-pie { margin-left: 22px; background: transparent; border-style: dashed; box-shadow: none; color: var(--suave); font-weight: 500; }
    .chip { display: inline-flex; align-items: center; gap: 4px; flex: none; min-width: 64px; height: 30px; padding: 0 10px; border-radius: 9px; background: var(--c); color: var(--oscuro); font-size: .8rem; font-weight: 800; }
    .chip .ic { width: 15px; height: 15px; }
    .chip.pie { min-width: 0; width: 30px; padding: 0; justify-content: center; border-radius: 50%; background: #fff3d6; color: #9a5b00; }

    /* El mapa con el recorrido y las paradas. */
    .mapita { position: relative; height: 230px; margin: 0 -28px; }
    .mapita svg { width: 100%; height: 100%; display: block; }
    .mm-fondo { fill: #dbe6fb; }
    .mm-calle { fill: none; stroke: #fff; stroke-width: 10; stroke-linecap: round; opacity: .8; }
    .mm-ruta { fill: none; stroke: var(--desvio); stroke-width: 6; stroke-linecap: round; }
    .mm-parada { fill: #fff; stroke: var(--desvio); stroke-width: 3.5; }
    .mm-parada.destino { fill: var(--desvio); stroke: #fff; }
    .mm-bus { fill: var(--neon); stroke: #fff; stroke-width: 3; }
    .bajate { position: absolute; right: 16%; top: 4px; padding: 6px 12px; border-radius: 999px; background: var(--oscuro); color: #fff; font-size: .78rem; font-weight: 700; }

    .extras { list-style: none; margin: 22px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px; }
    .extras li { display: flex; gap: 16px; align-items: flex-start; padding: 22px; border-radius: 22px; background: var(--tarjeta); border: 1px solid var(--borde); }
    .extra-icono { width: 42px; height: 42px; flex: none; border-radius: 13px; display: grid; place-items: center; color: var(--oscuro); background: var(--neon); }
    .extras h3 { margin: 0 0 4px; font-size: 1.05rem; }
    .extras p { margin: 0; color: var(--suave); font-size: .9rem; }

    @media (max-width: 960px) {
        .intro { grid-template-columns: 1fr; }
        .intro > p { order: 2; }
        .tarjetas { grid-template-columns: 1fr 1fr; }
        .tarjetas > li:last-child { grid-column: span 2; }
    }
    /* Tableta: la tarjeta que ocupa todo el ancho va en dos columnas, el mapa a un lado. */
    @media (min-width: 621px) and (max-width: 960px) {
        .tarjetas > li:last-child .tarjeta {
            height: auto; padding-bottom: 28px; display: grid; grid-template-columns: 1fr 1fr; column-gap: 28px; align-content: center; justify-items: end;
        }
        .tarjetas > li:last-child .mapita { grid-column: 1; grid-row: 1 / span 3; height: 220px; margin: 0; border-radius: 18px; overflow: hidden; justify-self: stretch; }
    }
    @media (max-width: 620px) {
        .seccion { padding: 80px 0 40px; }
        .titulo { gap: 16px; }
        .flecha { width: 40px; height: 40px; }
        .tarjetas, .extras { grid-template-columns: 1fr; }
        .tarjetas > li:last-child { grid-column: auto; }
        .tarjeta { height: 440px; }
    }
</style>
