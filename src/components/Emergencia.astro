---
/*
 * EL BOTÓN DE EMERGENCIA. Se presenta solo como acceso rápido al 911: Trazia
 * no vigila, no responde ni interviene; la emergencia la atiende la PNC.
 * Nunca describirlo como protección o seguridad.
 */
import Telefono from "./Telefono.astro";

const puntos = [
    { icono: "i-llamada", titulo: "Marca directo al 911", texto: "Sin andar buscando el número cuando no hay tiempo de buscarlo." },
    { icono: "i-lugar", titulo: "Tu ubicación a mano", texto: "Para que se la des al operador apenas te conteste." },
    { icono: "i-persona", titulo: "La atiende la PNC", texto: "Trazia no vigila, no responde ni interviene: de eso se encarga la Policía Nacional Civil. Trazia solo te acorta el camino hasta ellos." },
];
---
<section class="emergencia" id="emergencia">
    <div class="contenido">
        <div class="panel">
            <div class="texto">
                <p class="previa" data-revela>Botón de emergencia</p>
                <h2 data-revela>Un toque y estás <em>llamando al 911.</em></h2>
                <p class="bajada" data-revela>Si te sentís inseguro dentro del bus, presenciás un robo o necesitás reportar algo que está pasando en ese momento, tocás el botón y entra la llamada al 911.</p>
                <ul class="puntos" data-revela-grupo="0.15">
                    {puntos.map((p) => (
                        <li>
                            <i><svg class="ic" aria-hidden="true"><use href={`#${p.icono}`} /></svg></i>
                            <div><h3>{p.titulo}</h3><p>{p.texto}</p></div>
                        </li>
                    ))}
                </ul>
            </div>
            <div class="lado-telefono" data-revela>
                <Telefono escala={0.88} pantallas={["llamada"]} />
            </div>
        </div>
    </div>
</section>

<style>
    .emergencia { padding: 30px 0 20px; }
    .panel {
        position: relative; overflow: hidden; display: grid; grid-template-columns: 1.1fr .9fr; gap: 40px; align-items: center;
        padding: 64px; border-radius: 32px; background: #fdf1f0; border: 1px solid rgba(239, 68, 68, .16);
    }
    .panel::before { /* El resplandor rojo detrás del teléfono. */
        content: ""; position: absolute; width: 560px; height: 560px; right: -60px; top: 50%; margin-top: -280px; border-radius: 50%;
        background: radial-gradient(circle, rgba(239, 68, 68, .16), transparent 62%);
    }
    .texto { position: relative; }
    .previa { display: inline-flex; margin: 0 0 18px; padding: 6px 14px; border-radius: 999px; background: #fff; border: 1px solid rgba(239, 68, 68, .2); color: #b91c1c; font-size: .82rem; font-weight: 700; }
    h2 em { color: #b91c1c; }
    .bajada { margin: 18px 0 0; max-width: 34em; color: var(--suave); font-size: 1.05rem; }
    .puntos { list-style: none; margin: 28px 0 0; padding: 0; display: grid; gap: 14px; }
    .puntos li { display: flex; gap: 16px; align-items: flex-start; padding: 18px 20px; border-radius: 20px; background: #fff; border: 1px solid var(--borde); }
    .puntos i { width: 42px; height: 42px; flex: none; border-radius: 50%; display: grid; place-items: center; color: #b91c1c; background: #fde4e2; }
    .puntos h3 { margin: 0 0 4px; font-size: 1.05rem; }
    .puntos p { margin: 0; color: var(--suave); font-size: .92rem; }
    .lado-telefono { position: relative; display: flex; justify-content: center; }

    @media (max-width: 960px) {
        .panel { grid-template-columns: 1fr; padding: 48px 32px; }
        .panel::before { top: auto; bottom: -120px; right: 50%; margin: 0 -280px 0 0; }
    }
    @media (max-width: 620px) {
        .panel { padding: 36px 20px; border-radius: 24px; }
        .lado-telefono :global(.tel) { --escala: .8 !important; }
    }
</style>
