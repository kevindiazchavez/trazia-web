---
/*
 * El botón de Google Play. Lleva a PLAY_URL (src/config.ts); mientras esa URL
 * esté vacía, se ve igual pero no es un enlace.
 */
import { PLAY_URL } from "../config";

interface Props {
    chico?: boolean;
}
const { chico = false } = Astro.props;
const Etiqueta = PLAY_URL ? "a" : "span";
---
<Etiqueta class:list={["boton", { "boton-chico": chico, "boton-pronto": !PLAY_URL }]} href={PLAY_URL || undefined}>
    <svg class="ic" aria-hidden="true"><use href="#i-play" /></svg>
    <span><small>Disponible en</small>Google Play</span>
</Etiqueta>
