---
import Telefono from "./Telefono.astro";
import BotonPlay from "./BotonPlay.astro";

/*
 * EL FONDO: un mapa de ciudad visto desde arriba, sobre 1200 × 1150. Manzanas
 * tenues, tres autopistas en U que entran por un costado, pasan por debajo
 * del texto y detrás del teléfono y salen por el otro, y sobre cada una su
 * ruta de color con sus paradas. Los buses las recorren girando con la vía
 * (animations.ts, data-bus). El centro, donde va el título, queda despejado
 * con una máscara.
 */
const rutas = [
    { d: "M-40 160 C120 170 220 600 600 640 C980 600 1080 170 1240 160", color: "var(--neon)", linea: "#0fbf63" },
    { d: "M-40 340 C200 360 300 760 600 780 C900 760 1000 360 1240 340", color: "var(--desvio)", linea: "#3b82f6" },
    { d: "M-40 500 C200 520 330 840 600 850 C870 840 1000 520 1240 500", color: "var(--averia)", linea: "#e8890b" },
];
// Las paradas: el punto medio de cada curva, y su espejo del otro lado.
const paradas = [
    [197, 389, 0], [1003, 389, 0],
    [258, 560, 1], [942, 560, 1],
    [266, 689, 2], [934, 689, 2],
];

/* Los buses: en qué ruta van, desde qué punto de ella arrancan (0 a 1),
   cuánto tardan en recorrerla y si van de vuelta. `x`/`y` es dónde se ven
   sin JavaScript, sobre su ruta. */
const buses = [
    { ruta: 0, desde: 0.2, duracion: 22, x: 198, y: 389 },
    { ruta: 0, desde: 0.75, duracion: 22, vuelta: true, x: 1002, y: 389 },
    { ruta: 1, desde: 0.35, duracion: 20, x: 257, y: 560 },
    { ruta: 1, desde: 0.85, duracion: 20, vuelta: true, x: 943, y: 560 },
    { ruta: 2, desde: 0.55, duracion: 24, x: 290, y: 700 },
    { ruta: 2, desde: 0.1, duracion: 24, vuelta: true, x: 910, y: 700 },
];
---
<section class="portada" id="inicio">
    <div class="lineas" aria-hidden="true" data-hero>
        <svg viewBox="0 0 1200 1150" preserveAspectRatio="xMidYMin slice">
            <defs>
                <pattern id="manzanas" width="96" height="72" patternUnits="userSpaceOnUse" patternTransform="rotate(-8)">
                    <rect x="6" y="6" width="84" height="60" rx="9" class="manzana" />
                    <rect x="6" y="6" width="38" height="60" rx="9" class="manzana clara" />
                </pattern>
                <!-- El volumen del bus: los costados en sombra y el techo con luz. Va encima del color de cada bus. -->
                <linearGradient id="bus-volumen" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#000" stop-opacity=".14" />
                    <stop offset=".2" stop-color="#fff" stop-opacity=".08" />
                    <stop offset=".5" stop-color="#fff" stop-opacity=".32" />
                    <stop offset=".8" stop-color="#fff" stop-opacity=".08" />
                    <stop offset="1" stop-color="#000" stop-opacity=".16" />
                </linearGradient>
                <linearGradient id="bus-vidrio" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#64748b" />
                    <stop offset=".45" stop-color="#94a3b8" />
                    <stop offset=".55" stop-color="#cbd5e1" />
                    <stop offset="1" stop-color="#64748b" />
                </linearGradient>
            </defs>
            <rect x="-100" y="-100" width="1400" height="1350" fill="url(#manzanas)" />
            <!-- Las autopistas de dos sentidos: borde, asfalto y las orillas punteadas. -->
            {rutas.map((r) => <path class="via-borde" d={r.d} />)}
            {rutas.map((r) => <path class="via" d={r.d} />)}
            {rutas.map((r) => <path class="carril" d={r.d} />)}
            {rutas.map((r) => <path class="carril-tapa" d={r.d} />)}
            <!-- La ruta de cada bus, encima de su autopista. -->
            {rutas.map((r) => <path class="ruta" style={`--linea: ${r.linea}`} d={r.d} pathLength="1" data-linea />)}
            {paradas.map(([x, y, i]) => <circle class="parada" style={`--linea: ${rutas[i].linea}`} cx={x} cy={y} r="6" />)}
            {buses.map((b) => (
                <g
                    class="bus"
                    style={`--color: ${rutas[b.ruta].color}`}
                    transform={`translate(${b.x} ${b.y})`}
                    data-bus
                    data-ruta={b.ruta}
                    data-desde={b.desde}
                    data-duracion={b.duracion}
                    data-vuelta={b.vuelta ? "" : undefined}
                >
                    <!-- El bus en 3D visto desde arriba, mirando hacia la derecha (+x). GSAP lo gira hacia donde
                         avanza (también al que va de vuelta), y va por el carril de su derecha. -->
                    <!-- Marco invisible y simétrico: GSAP centra el bus con su contorno, y sin esto
                         el corrimiento al carril se anularía. -->
                    <rect x="-30" y="-24" width="60" height="48" fill="none" />
                    <g transform="translate(0 13) scale(.74)">
                        <rect class="sombra" x="-33" y="-9" width="70" height="26" rx="8" />
                        <!-- Espejos adelante, a los lados. -->
                        <path class="espejo" d="M29 -12.5v-2.5h2.2v-1.6h1.6v4.1z M29 12.5v2.5h2.2v1.6h1.6v-4.1z" />
                        <rect class="carroceria" x="-35" y="-12.5" width="70" height="25" rx="6.5" />
                        <rect x="-35" y="-12.5" width="70" height="25" rx="6.5" fill="url(#bus-volumen)" />
                        <!-- Brillo del techo pintado, a lo largo. -->
                        <path class="reflejo" d="M-22 -7.5H26" />
                        <!-- Atrás: la luneta, la tapa del motor y las luces. -->
                        <path class="luneta" d="M-25 -10.5h-5a3 3 0 0 0-3 3v15a3 3 0 0 0 3 3h5z" fill="url(#bus-vidrio)" />
                        <!-- Escotillas del techo. -->
                        <rect class="escotilla" x="-17" y="-3.2" width="6.4" height="6.4" rx=".9" />
                        <rect class="escotilla" x="21" y="-3.2" width="6.4" height="6.4" rx=".9" />
                        <!-- El aire acondicionado: un bloque alzado en medio del techo, con sus ventiladores. -->
                        <rect class="sombra-modulo" x="-4.2" y="-10" width="22" height="20.6" rx="3.2" />
                        <rect class="carroceria" x="-3" y="-10.3" width="22" height="20.6" rx="3.2" />
                        <rect x="-3" y="-10.3" width="22" height="20.6" rx="3.2" fill="url(#bus-volumen)" />
                        <rect class="modulo-borde" x="-3" y="-10.3" width="22" height="20.6" rx="3.2" />
                        <rect class="rejilla" x="1" y="-3" width="14" height="6" rx=".8" />
                        <g class="ventilador">
                            <circle cx="3" cy="0" r="1.6" /><circle cx="6.3" cy="0" r="1.6" />
                            <circle cx="9.6" cy="0" r="1.6" /><circle cx="12.9" cy="0" r="1.6" />
                        </g>
                        <rect class="borde" x="-35" y="-12.5" width="70" height="25" rx="6.5" />
                        <!-- Las luces van encima del borde para que se vean. -->
                        <path class="luz-trasera" d="M-34.6 -10.4h2v4h-2z M-34.6 6.4h2v4h-2z" />
                        <path class="faro" d="M32.8 -9.6h1.8v3h-1.8z M32.8 6.6h1.8v3h-1.8z" />
                    </g>
                </g>
            ))}
        </svg>
    </div>

    <div class="contenido">
        <h1 data-hero data-hero-titulo>Llegá a tu destino en bus, <em>con Trazia.</em></h1>
        <p class="bajada" data-hero data-hero-pieza>Escribí adónde querés ir y descubrí qué buses tomar, dónde subirte, dónde hacer transbordo y dónde bajarte, con el tiempo y el costo estimados de tu viaje.</p>
        <div class="acciones" data-hero data-hero-pieza>
            <BotonPlay />
            <span class="nota"><svg class="ic" aria-hidden="true"><use href="#i-check" /></svg>Para Android · iPhone más adelante</span>
        </div>
    </div>

    <div class="escenario" data-hero data-hero-telefono>
        <Telefono />
    </div>
</section>

<style>
    .portada { position: relative; padding-top: 150px; text-align: center; }
    /* El mapa: el centro, detrás del título, se desvanece para que el texto se lea limpio. */
    .lineas {
        position: absolute; inset: 0; z-index: -1; pointer-events: none;
        -webkit-mask-image: radial-gradient(ellipse 36% 26% at 50% 27%, transparent 30%, #000 100%);
        mask-image: radial-gradient(ellipse 36% 26% at 50% 27%, transparent 30%, #000 100%);
    }
    .lineas > svg { position: absolute; inset: 0; width: 100%; height: 100%; }
    .manzana { fill: #f5f6f8; }
    .manzana.clara { fill: #f9fafb; }
    .via-borde, .via, .carril, .ruta { fill: none; stroke-linecap: round; }
    .via-borde { stroke: #e2e6ea; stroke-width: 54; }
    .via { stroke: #eef1f4; stroke-width: 50; }
    /* Las orillas de la autopista, punteadas; al centro, la línea de la ruta divide los dos sentidos. */
    .carril { stroke: #fff; stroke-width: 40; stroke-dasharray: 14 16; opacity: .9; }
    .carril-tapa { fill: none; stroke: #eef1f4; stroke-width: 37; }
    .ruta { stroke: var(--linea); stroke-width: 3.5; opacity: .75; }
    .parada { fill: #fff; stroke: var(--linea); stroke-width: 3; }
    /* El bus: color de su ruta, con volumen, vidrios oscuros, faros y sombra suave en el piso. */
    .bus .sombra { fill: rgba(17, 24, 39, .1); }
    .bus .espejo { fill: #4b5563; }
    .bus .carroceria { fill: var(--color); }
    .bus .sombra-modulo { fill: rgba(15, 23, 42, .18); }
    .bus .modulo-borde { fill: none; stroke: rgba(255, 255, 255, .55); stroke-width: .8; }
    .bus .escotilla { fill: #6b7280; stroke: rgba(255, 255, 255, .6); stroke-width: .7; }
    .bus .rejilla { fill: #6b7280; }
    .bus .ventilador circle { fill: #9ca3af; stroke: #e5e7eb; stroke-width: .5; }
    .bus .reflejo { stroke: rgba(255, 255, 255, .4); stroke-width: 1.6; stroke-linecap: round; }
    .bus .faro { fill: #fde68a; }
    .bus .luz-trasera { fill: #ef4444; }
    .bus .borde { fill: none; stroke: #fff; stroke-width: 1.6; }

    h1 { margin: 0 auto 20px; max-width: 15ch; font-size: clamp(2.4rem, 5.4vw, 4.1rem); line-height: 1.05; }
    .bajada { margin: 0 auto 32px; max-width: 34em; color: var(--suave); font-size: clamp(1rem, 1.6vw, 1.12rem); }
    .acciones { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 14px 22px; }
    .nota { display: inline-flex; align-items: center; gap: 8px; color: var(--suave); font-size: .92rem; }
    .nota .ic { width: 20px; height: 20px; color: var(--verde-oscuro); }

    /* El teléfono, con la parte de abajo esfumándose como la mano de la referencia. */
    .escenario {
        position: relative; height: 560px; margin-top: 60px; display: flex; justify-content: center;
        -webkit-mask-image: linear-gradient(180deg, #000 72%, transparent);
        mask-image: linear-gradient(180deg, #000 72%, transparent);
    }
    .escenario::before {
        content: ""; position: absolute; z-index: -1; width: 640px; height: 640px; left: 50%; top: 40px; margin-left: -320px;
        border-radius: 50%; background: radial-gradient(circle, rgba(0, 230, 118, .18), transparent 62%);
    }

    /* En pantallas angostas las rutas pasarían por detrás del texto: no se muestran. */
    @media (max-width: 960px) {
        .portada { padding-top: 120px; }
        .lineas { display: none; }
    }
    @media (max-width: 620px) {
        .escenario { height: 480px; margin-top: 48px; }
        .escenario :global(.tel) { --escala: .84 !important; }
    }
</style>
