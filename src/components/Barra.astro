---
/* La barra de arriba. Al bajar, animations.ts le pone `con-fondo` y aparece el fondo con blur. */
---
<header class="barra" data-barra>
    <div class="contenido">
        <a class="marca" href="#inicio"><img src="/marca/trazia-logo.png" alt="" width="36" height="36">Trazia</a>
        <nav class="menu" aria-label="Secciones">
            <a href="#que-hace">Qué hace</a>
            <a href="#como-funciona">Cómo funciona</a>
            <a href="#seguridad">Viaja seguro</a>
        </nav>
        <a class="boton boton-chico" href="#descargar">Descargar</a>
    </div>
</header>

<style>
    .barra { position: fixed; inset: max(12px, env(safe-area-inset-top)) 0 auto; z-index: 20; pointer-events: none; }
    .contenido {
        max-width: 1400px; height: 68px; display: flex; align-items: center; justify-content: space-between; gap: 16px;
        pointer-events: auto; border-radius: 999px;
    }
    /* El fondo con blur: una capa que aparece con opacidad. */
    .contenido::before {
        content: ""; position: absolute; inset: 0 clamp(4px, 2vw, 32px); z-index: -1; border-radius: inherit;
        background: rgba(255, 255, 255, .78); border: 1px solid var(--borde);
        backdrop-filter: blur(16px) saturate(140%); -webkit-backdrop-filter: blur(16px) saturate(140%);
        box-shadow: 0 16px 34px -22px rgba(17, 24, 39, .35);
        opacity: 0; transition: opacity .3s ease;
    }
    :global(.barra.con-fondo) .contenido::before { opacity: 1; }
    .marca { display: inline-flex; align-items: center; gap: 10px; color: var(--texto); text-decoration: none; font-weight: 800; font-size: 1.2rem; letter-spacing: -.02em; }
    .marca img { width: 36px; height: 36px; border-radius: 50%; box-shadow: 0 0 0 1px var(--borde), 0 0 24px -6px var(--brillo); }
    .menu { display: flex; gap: 32px; font-size: .92rem; font-weight: 600; }
    .menu a { color: var(--texto); text-decoration: none; transition: opacity .2s; }
    .menu a:hover { opacity: .7; }
    @media (max-width: 760px) {
        .barra { top: max(6px, env(safe-area-inset-top)); }
        .menu { display: none; }
    }
    @media (prefers-reduced-motion: reduce) {
        .contenido::before { transition: none; }
    }
</style>
