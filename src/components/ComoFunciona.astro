---
import Telefono from "./Telefono.astro";
import BotonPlay from "./BotonPlay.astro";

const pasos = [
    { titulo: "Escribí a dónde vas", texto: "Buscás el lugar por su nombre y Trazia arma el viaje desde donde estás." },
    { titulo: "Elegí tu viaje", texto: "Comparás las opciones por tiempo, caminata y costo total, y te quedás con la que más te sirve." },
    { titulo: "Mirá cada tramo", texto: "Dónde subirte, dónde bajarte y, si hay transbordo, el punto exacto donde cambiar de bus." },
    { titulo: "Seguí el recorrido", texto: "El viaje se dibuja en el mapa con las paradas marcadas, para que sepás cuándo te toca bajar." },
];
---
<section class="seccion" id="como-funciona">
    <div class="contenido">
        <div class="encabezado">
            <h2 data-revela>¿No sabés qué bus tomar? <em>Trazia te guía.</em></h2>
            <p data-revela>Buscá tu destino, conocé las rutas que podés tomar y seguí tu recorrido hasta llegar.</p>
        </div>

        <div class="recorrido">
            <ol class="pasos">
                {pasos.map((p, i) => (
                    <li class="paso elevable" tabindex="0" data-paso>
                        <div class="paso-cabeza">
                            <h3>{p.titulo}</h3>
                            <span class="paso-num">{String(i + 1).padStart(2, "0")}</span>
                        </div>
                        <p>{p.texto}</p>
                    </li>
                ))}
            </ol>

            <!-- En escritorio el teléfono se queda fijo mientras pasan los pasos, y muestra la pantalla de cada uno. -->
            <aside class="lateral" data-revela data-pasos-telefono>
                <Telefono escala={0.9} pantallas={["inicio", "opciones", "itinerario", "recorrido"]} />
                <div class="lateral-texto">
                    <p>Cada paso, tal como lo vas a ver en la app.</p>
                    <BotonPlay chico />
                </div>
            </aside>
        </div>
    </div>
</section>

<style>
    .seccion { padding: 110px 0; }
    .encabezado { display: grid; grid-template-columns: 1.15fr .85fr; gap: 24px 64px; align-items: start; margin-bottom: 64px; }
    .encabezado p { margin: 8px 0 0; color: var(--suave); }

    .recorrido { display: grid; grid-template-columns: 1.1fr .9fr; gap: 56px; align-items: start; }
    .pasos { list-style: none; margin: 0; padding: 40px 0 120px; display: grid; gap: 56px; }
    .paso { width: 76%; padding: 22px 24px; border-radius: 22px; background: var(--tarjeta); border: 1px solid var(--borde); cursor: pointer; }
    .paso:focus-visible { outline: 2px solid var(--verde-oscuro); outline-offset: 3px; }
    .paso:nth-child(odd) { justify-self: end; }
    /* El borde verde del paso activo: una capa que aparece. */
    .paso::before {
        content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
        box-shadow: inset 0 0 0 1px rgba(0, 230, 118, .55); opacity: 0; transition: opacity .3s ease;
    }
    :global(.paso.es-activo)::before { opacity: 1; }
    .paso-cabeza { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 10px; }
    .paso h3 { margin: 0; font-size: 1.1rem; letter-spacing: -.02em; }
    .paso-num {
        flex: none; width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center;
        font-size: .85rem; font-weight: 800; color: var(--verde-oscuro); background: var(--acento-claro);
    }
    .paso p { margin: 0; color: var(--suave); font-size: .95rem; }

    .lateral { position: sticky; top: 110px; display: flex; align-items: flex-end; gap: 28px; }
    .lateral-texto { min-width: 0; padding-bottom: 40px; }
    .lateral-texto p { margin: 0 0 16px; color: var(--suave); font-size: .92rem; max-width: 15em; }

    @media (max-width: 960px) {
        .encabezado, .recorrido { grid-template-columns: 1fr; }
        .pasos { padding: 0; gap: 18px; }
        .paso { width: 100%; }
        .lateral { position: static; justify-content: center; flex-wrap: wrap; }
        .lateral-texto { padding-bottom: 0; text-align: center; }
        .lateral-texto p { margin-inline: auto; }
    }
    @media (max-width: 620px) {
        .seccion { padding: 80px 0; }
        .encabezado { margin-bottom: 40px; }
        .lateral :global(.tel) { --escala: .8 !important; }
    }
    @media (prefers-reduced-motion: reduce) {
        .paso::before { transition: none; }
    }
</style>
