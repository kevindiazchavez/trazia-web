---
import { legales } from "../config";

/* Desde las páginas legales, los enlaces a las secciones vuelven a la portada. */
interface Props {
    base?: string;
}
const { base = "" } = Astro.props;
---
<footer class="pie">
    <div class="contenido">
        <div class="fila">
            <a class="marca" href={`${base}#inicio`}><img src="/marca/trazia-logo-128.png" alt="" width="34" height="34">Trazia</a>
            <nav aria-label="Secciones">
                <a href={`${base}#que-hace`}>Qué hace</a>
                <a href={`${base}#como-funciona`}>Cómo funciona</a>
                <a href={`${base}#emergencia`}>Botón de emergencia</a>
                <a href={`${base}#descargar`}>Descargar</a>
            </nav>
        </div>
        <div class="fila legal">
            <p>© {new Date().getFullYear()} Trazia · Hecho en El Salvador.</p>
            <ul>
                <li><a href={legales.privacidad}>Política de privacidad</a></li>
                <li><a href={legales.terminos}>Términos de uso</a></li>
                <li><a href={legales.eliminarCuenta}>Eliminar cuenta</a></li>
            </ul>
        </div>
    </div>
</footer>

<style>
    .pie { padding: 20px 0 max(40px, env(safe-area-inset-bottom)); font-size: .92rem; }
    .fila { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px 40px; padding: 24px 0; }
    .marca { display: inline-flex; align-items: center; min-height: 48px; gap: 10px; color: var(--texto); text-decoration: none; font-weight: 800; font-size: 1.25rem; letter-spacing: -.02em; }
    .marca img { width: 34px; height: 34px; border-radius: 50%; }
    nav { display: flex; flex-wrap: wrap; gap: 0 28px; }
    nav a, ul a { display: inline-flex; align-items: center; min-height: 48px; }
    a { color: var(--suave); text-decoration: none; transition: opacity .2s; }
    nav a:hover, ul a:hover { opacity: .7; }
    .legal { border-top: 1px solid var(--borde); color: var(--tenue); }
    .legal p { margin: 0; }
    ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 24px; }
</style>
