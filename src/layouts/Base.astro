---
import "../styles/global.css";
import Iconos from "../components/Iconos.astro";

interface Props {
    titulo: string;
    descripcion: string;
}
const { titulo, descripcion } = Astro.props;
---
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="description" content={descripcion}>
    <meta name="theme-color" content="#ffffff">
    <link rel="icon" type="image/png" href="/marca/trazia-logo.png">
    <link rel="preload" href="/marca/plus-jakarta-sans.ttf" as="font" type="font/ttf" crossorigin>
    <title>{titulo}</title>
    <script is:inline>
        // Marca que hay JavaScript, para que la portada espere a sus animaciones.
        // Si animations.ts no llega, a los 3 s se muestra igual.
        document.documentElement.classList.add("js");
        setTimeout(function () { document.documentElement.classList.add("anim-listo"); }, 3000);
    </script>
</head>
<body>
    <Iconos />
    <slot />
</body>
</html>
