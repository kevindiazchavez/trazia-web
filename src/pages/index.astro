---
import Base from "../layouts/Base.astro";
import Barra from "../components/Barra.astro";
import Portada from "../components/Portada.astro";
import QueHace from "../components/QueHace.astro";
import ComoFunciona from "../components/ComoFunciona.astro";
import Encuesta from "../components/Encuesta.astro";
import Emergencia from "../components/Emergencia.astro";
import Final from "../components/Final.astro";
import Pie from "../components/Pie.astro";
---
<Base
    titulo="Trazia · Cómo llegar en bus a cualquier lugar de El Salvador"
    descripcion="Escribes a dónde vas y Trazia arma tu viaje en bus: qué buses tomar, dónde subirte, dónde bajarte, cuánto vas a tardar y cuánto vas a pagar. 874 rutas en todo El Salvador."
>
    <Barra />
    <div class="marco">
        <!-- Los degradados del fondo; animations.ts los mueve muy despacio. -->
        <div class="manchas" aria-hidden="true">
            <span class="mancha mancha-1" data-mancha></span>
            <span class="mancha mancha-2" data-mancha></span>
            <span class="mancha mancha-3" data-mancha></span>
            <span class="mancha mancha-4" data-mancha></span>
        </div>
        <main>
            <Portada />
            <Encuesta />
            <QueHace />
            <ComoFunciona />
            <Emergencia />
            <Final />
        </main>
        <Pie />
    </div>

    <script>
        import "../scripts/animations.ts";
    </script>
</Base>
